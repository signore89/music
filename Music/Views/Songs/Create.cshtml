@using Music.ViewsModels
@model CreatedSongViewModels

@{
    ViewData["Title"] = "Добавление трека";
}

<h4>Трэк</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label">Название трэка</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="File" class="control-label">Выбирите трэк</label>
                <input asp-for="File" type="file" class="form-control" />
            </div>
            @if (Model.AlbumId == 0)
            {
                <div class="form-group">
                <label asp-for="AlbumId" class="control-label">ID альбома</label>
                    <select asp-for="AlbumId" class="form-control" asp-items="ViewBag.Albums">
                        <option selected="selected" disabled="disabled">Выберите альбом</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Name" class="control-label">Имя исполнителя</label>
                    <select asp-for="Name" class="form-control" asp-items="ViewBag.Artists">
                        <option selected="selected" disabled="disabled">Выберите исполнителя</option>
                    </select>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label asp-for="AlbumId" class="control-label">ID альбома</label>
                    <input asp-for="AlbumId" class="form-control" value=@Model.AlbumId/>
                </div>
            }

            <div class="form-group">
                <input type="submit" value="Добавить" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Вернуться</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
